---
import MarketingLayout from '../layouts/MarketingLayout.astro';
import PageHero from '../components/PageHero.astro';
import ServiceCard from '../components/ServiceCard.astro';
import FAQList from '../components/FAQList.astro';
import ClosingCTA from '../components/ClosingCTA.astro';
import WhatsAppCTA from '../components/WhatsAppCTA.astro';
import { services } from '../data/services';
import { faqs } from '../data/faqs';
import { localBusinessSchema, faqSchema } from '../utils/schema';
const guide = [
  ['Butuh materi video promosi produk', 'jasa-video-pendek'],
  ['Ingin website berada di ranking teratas Google', 'jasa-seo-artikel'],
  ['Website lambat dan butuh hosting cepat & aman', 'hosting-optimasi-website'],
  ['Akun medsos sepi dan butuh konten rutin', 'pengelolaan-media-sosial'],
  ['Ingin pasang iklan berbayar yang terukur', 'jasa-iklan-digital'],
  ['Perlu website profil bisnis resmi', 'jasa-pembuatan-website']
];
const steps = [
  '1. Konsultasi WhatsApp',
  '2. Analisis Kebutuhan Bisnis',
  '3. Kesepakatan Ruang Lingkup & Biaya',
  '4. Eksekusi Pengerjaan',
  '5. Evaluasi & Serah Terima'
];
---
<MarketingLayout
  title="Layanan Pemasaran Digital UMKM Jawa Timur"
  description="Enam layanan digital terpadu untuk UMKM: video pendek, jasa SEO & artikel, hosting & optimasi web, media sosial, iklan digital, dan website."
  breadcrumbs={[{ label: 'Beranda', href: '/' }, { label: 'Layanan' }]}
  schema={[
    localBusinessSchema(),
    faqSchema(faqs.filter((f) => f.group === 'Layanan' || f.group === 'Harga'))
  ]}
>
  <PageHero title="Solusi Pemasaran Digital Terpadu untuk UMKM" lead="Fokus pada solusi yang paling Anda butuhkan saat ini. Setiap layanan dirancang praktis, terukur, dan disesuaikan dengan kapasitas riil usaha Anda.">
    <div style="margin-top:1.5rem"><WhatsAppCTA /></div>
  </PageHero>
  <section class="section"><div class="container">
    <div class="matrix">{services.map((s, i) => <ServiceCard service={s} index={i} withImage />)}</div>
  </div></section>
  <section class="section section--tint"><div class="container split">
    <h2>Panduan Memilih Solusi yang Tepat</h2>
    <ul class="checklist">{guide.map(([t, slug]) => (<li>{t}: <a href={`/layanan/${slug}/`} style="color:var(--dp-color-accent)">{services.find((s) => s.slug === slug)!.name}</a></li>))}</ul>
  </div></section>
  <section class="section"><div class="container">
    <h2 style="margin-bottom:2rem">5 Langkah Kerja yang Terarah</h2>
    <ol class="steps">{steps.map((t) => (<li><h3>{t}</h3></li>))}</ol>
  </div></section>
  <section class="section section--tint"><div class="container split">
    <h2>Pertanyaan Umum Seputar Layanan & Biaya</h2><FAQList items={faqs.filter((f) => ['Layanan', 'Harga'].includes(f.group))} />
  </div></section>
  <ClosingCTA secondaryHref="/portofolio/" secondaryLabel="Lihat portofolio" />
</MarketingLayout>
