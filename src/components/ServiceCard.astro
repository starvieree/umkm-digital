---
const { service, index, withImage = false } = Astro.props;
const href = `/layanan/${service.slug}`;
---
<article class="service-card cell">
  {withImage && (
    <a href={href} class="service-img-wrap" tabindex="-1" aria-hidden="true">
      <img src={`/images/services/${service.slug}.webp`} alt={service.name} width="600" height="400" loading="lazy" class="service-img" />
    </a>
  )}
  <span class="idx mono">{String(index + 1).padStart(2, '0')}</span>
  <h3><a class="title-link" href={href}>{service.name}</a></h3>
  <p>{service.short}</p>
  <a class="more" href={href}>
    <span>Pelajari layanan</span>
    <svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M3 8h10M9 4l4 4-4 4"/></svg>
    <span class="sr-only"> {service.name}</span>
  </a>
</article>
