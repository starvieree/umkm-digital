---
const { href, variant = 'primary', arrow = false, external = false, class: cls = '' } = Astro.props;
const ext = external ? { target: '_blank', rel: 'noopener noreferrer' } : {};
---
<a href={href} class={`btn btn--${variant} ${cls}`} {...ext}>
  <slot />
  {arrow && (<svg class="btn-arrow" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M3 8h10M9 4l4 4-4 4" /></svg>)}
</a>
