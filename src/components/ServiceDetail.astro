---
import MarketingLayout from '../layouts/MarketingLayout.astro';
import ClosingCTA from './ClosingCTA.astro';
import FAQList from './FAQList.astro';
import WhatsAppCTA from './WhatsAppCTA.astro';
import Button from './Button.astro';
import { getService } from '../data/services';
import { serviceSchema, faqSchema, localBusinessSchema } from '../utils/schema';
const { slug } = Astro.props;
const s = getService(slug);
const related = s.related.map(getService);
const steps = [
  ['1. Konsultasi Awal', 'Ceritakan profil usaha, produk unggulan, dan target yang ingin dicapai.'],
  ['2. Pengumpulan Materi', 'Kami bantu susun daftar materi dan informasi yang dibutuhkan sebelum mulai.'],
  ['3. Kesepakatan Tertulis', 'Ruang lingkup pekerjaan, batas revisi, dan biaya disepakati bersama di awal.'],
  ['4. Eksekusi & Review', 'Pekerjaan dijalankan sesuai jadwal, lengkap dengan kesempatan review dan perbaikan.'],
  ['5. Serah Terima & Evaluasi', 'Hasil diserahkan siap pakai beserta panduan ringkas dan evaluasi kerja.']
];
---
<MarketingLayout
  title={`${s.name} Jawa Timur`}
  description={s.short}
  image={`/images/services/${s.slug}.webp`}
  imageAlt={`Layanan ${s.name} untuk UMKM Jawa Timur`}
  breadcrumbs={[{ label: 'Beranda', href: '/' }, { label: 'Layanan', href: '/layanan' }, { label: s.name }]}
  schema={[
    serviceSchema(s),
    faqSchema(s.faqs),
    localBusinessSchema()
  ]}
>
  <section class="page-hero">
    <div class="container detail-hero">
      <div>
        <p class="eyebrow">{s.name}</p>
        <h1 style="margin-top:.75rem">{s.headline}</h1>
        <p class="lead">{s.intro}</p>
        <div class="row" style="margin-top:1.75rem">
          <WhatsAppCTA message={s.waMessage} />
          <Button href="/portofolio" variant="secondary">Lihat portofolio</Button>
        </div>
      </div>
      <img src={`/images/services/${s.slug}.webp`} alt={`Layanan ${s.name} untuk UMKM`} width="1200" height="800" fetchpriority="high" />
    </div>
  </section>

  <section class="section">
    <div class="container cols-2">
      <div class="panel"><h2 style="font-size:1.5rem;margin-bottom:.75rem">Untuk Siapa Layanan Ini Cocok?</h2><ul class="checklist">{s.forWho.map((x) => <li>{x}</li>)}</ul></div>
      <div class="panel"><h2 style="font-size:1.5rem;margin-bottom:.75rem">Kendala yang Siap Kami Bantu Tuntaskan</h2><ul class="checklist">{s.problems.map((x) => <li>{x}</li>)}</ul></div>
    </div>
  </section>

  <section class="section section--tint">
    <div class="container">
      <h2 style="margin-bottom:2rem">Ruang Lingkup Pekerjaan & Kebutuhan Materi</h2>
      <div class="cols-2">
        <div><h3 style="margin-bottom:.5rem">Yang Kami Kerjakan</h3><ul class="checklist">{s.scope.map((x) => <li>{x}</li>)}</ul></div>
        <div><h3 style="margin-bottom:.5rem">Yang Perlu Anda Siapkan</h3><ul class="checklist">{s.clientNeeds.map((x) => <li>{x}</li>)}</ul></div>
      </div>
      <p class="note" style="margin-top:2rem">{s.note}</p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <h2 style="margin-bottom:2rem">Tahapan Pengerjaan</h2>
      <ol class="steps">{steps.map(([t, d]) => (<li><h3>{t}</h3><p>{d}</p></li>))}</ol>
    </div>
  </section>

  <section class="section section--tint">
    <div class="container split">
      <div>
        <h2>Estimasi Biaya & Paket Layanan</h2>
        <p class="lead" style="margin-top:1rem">Biaya disesuaikan transparan dengan ruang lingkup pekerjaan. Diskusikan kebutuhan usaha Anda untuk penawaran terbaik.</p>
        <div style="margin-top:1.5rem"><WhatsAppCTA message={s.waMessage} label="Minta penawaran" /></div>
      </div>
      <div class="panel panel--accent"><h3>Faktor Penentu Biaya</h3><ul class="checklist">{s.priceFactors.map((x) => <li>{x}</li>)}</ul></div>
    </div>
  </section>

  <section class="section">
    <div class="container split">
      <h2>Tanya Jawab Seputar {s.name}</h2>
      <FAQList items={s.faqs} />
    </div>
  </section>

  <section class="section section--tint">
    <div class="container">
      <h2 style="margin-bottom:2rem">Layanan Pendukung Terkait</h2>
      <div class="matrix matrix--2">
        {related.map((r) => (
          <article class="cell"><h3><a class="title-link" href={`/layanan/${r.slug}`}>{r.name}</a></h3><p>{r.short}</p><a class="more" href={`/layanan/${r.slug}`}>Pelajari layanan<span class="sr-only"> {r.name}</span></a></article>
        ))}
      </div>
    </div>
  </section>
  <ClosingCTA message={s.waMessage} secondaryHref="/portofolio" secondaryLabel="Lihat portofolio" />
</MarketingLayout>
