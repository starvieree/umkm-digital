---
import WhatsAppCTA from './WhatsAppCTA.astro';
import Button from './Button.astro';
const { title = 'Siap Mengembangkan Pemasaran Digital Usaha Anda?', text = 'Ceritakan produk dan kendala usaha Anda kepada tim kami via WhatsApp. Kami bantu susun solusi yang tepat sesuai kapasitas dan anggaran bisnis Anda.', message, secondaryHref = '/layanan/', secondaryLabel = 'Lihat layanan' } = Astro.props;
---
<section class="closing">
  <div class="container">
    <div>
      <h2>{title}</h2>
      <p class="lead">{text}</p>
    </div>
    <div class="row">
      <WhatsAppCTA message={message} />
      <Button href={secondaryHref} variant="secondary">{secondaryLabel}</Button>
    </div>
  </div>
</section>
