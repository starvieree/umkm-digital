---
import { formatDate } from "../utils/seo";
const { entry } = Astro.props;
const d = entry.data;
---

<article class="blog-card">
  {
    d.coverImage && (
      <a
        href={`/blog/${entry.slug}`}
        class="blog-card-img-wrap"
        tabindex="-1"
        aria-hidden="true"
      >
        <img
          src={d.coverImage}
          alt={d.coverAlt ?? d.title}
          width="600"
          height="400"
          loading="lazy"
          class="blog-card-img"
        />
      </a>
    )
  }
  <div class="blog-meta">
    {d.author && <span class="blog-author">{d.author}</span>}
    {
      d.author && (
        <span class="blog-meta-sep" aria-hidden="true">
          ·
        </span>
      )
    }
    <time datetime={d.pubDate.toISOString()}>{formatDate(d.pubDate)}</time>
  </div>
  <h3 class="blog-title">
    <a class="title-link" href={`/blog/${entry.slug}`}>{d.title}</a>
  </h3>
  <p class="blog-desc">{d.description}</p>
  <a href={`/blog/${entry.slug}`} class="blog-btn-more">
    <span>Baca Selengkapnya</span>
    <svg
      width="14"
      height="14"
      viewBox="0 0 16 16"
      fill="none"
      stroke="currentColor"
      stroke-width="1.8"
      aria-hidden="true"><path d="M3 8h10M9 4l4 4-4 4"></path></svg
    >
  </a>
</article>
